# Copy to .env for local development. Never commit the real .env.

# Models: "gemini", "groq" or "mock" (mock needs no keys)
PUNDIT_ANSWER_PROVIDER=gemini
PUNDIT_ANSWER_MODEL=gemini-2.5-flash
PUNDIT_JUDGE_PROVIDER=groq
PUNDIT_JUDGE_MODEL=openai/gpt-oss-120b
PUNDIT_OPPONENT_PROVIDER=groq
PUNDIT_OPPONENT_MODEL=llama-3.3-70b-versatile
PUNDIT_GEMINI_API_KEY=
PUNDIT_GROQ_API_KEY=

# Local: SQLite. Production: a hosted Postgres URL, e.g. postgresql+psycopg://user:pass@host/db
# PUNDIT_DATABASE_URL=sqlite:///./pundit.db

# "hashing" skips downloading the embedding model (offline dev only; never for published numbers)
PUNDIT_EMBEDDER=sentence-transformers

PUNDIT_CACHE_THRESHOLD=0.88
PUNDIT_DAILY_LLM_BUDGET=800
PUNDIT_CORS_ORIGINS=["http://localhost:3000"]
PUNDIT_IP_SALT=change-me
